/scoreboard players set #1000 num 1000
/scoreboard players set #100 num 100
/scoreboard players set #10 num 10

##############
##  트리거   ##
##############
    def add_trigger(var type, var source, var data){
        # card 파라미터에서 functions, type, delay 받아오는걸로 바꾸기
        set_data("storage", "40planet:dus", 'element', {
            type: type,
            source: source, # card, owner
            data: data
        });
        /data modify storage 40planet:dus ingame.trigger_queue prepend from storage 40planet:dus element

        # 체인 스택에 이벤트 추가했다는 플래그 보내기. 이후 플래그처리 단계에서 처리
        /scoreboard players add #add_trigger flag 1
    }

    def test_add_trigger(){
        add_trigger(2101, {
            card:-1,
            owner: get_data("storage", "40planet:dus", "ingame.player1.uuid")
        }, {})
    }

    def reset_trigger_queue(){
        /data modify storage 40planet:dus ingame.trigger_queue set value []
    }

    def trigger_top(){
        return get_data("storage", "40planet:dus", "ingame.trigger_queue[0]");
    }
#



###################
##  발동가능 검사  ##
###################

    def check_trigger(var trigger_num, var criteria_num){
        set_score("#trigger_type", "num", trigger_num);
        set_score("#criteria_type", "num", criteria_num);

        /scoreboard players operation #temp num = #trigger_type num
        /scoreboard players operation #temp2 num = #criteria_type num
        /scoreboard players operation #temp num %= #100 num
        /scoreboard players operation #temp2 num %= #100 num
        execute(unless score "#temp2" num matches 0 unless score "#temp" num = "#temp2" num){ return 0; }

        /scoreboard players operation #trigger_type num /= #100 num
        /scoreboard players operation #criteria_type num /= #100 num
        /scoreboard players operation #temp num = #trigger_type num
        /scoreboard players operation #temp2 num = #criteria_type num
        /scoreboard players operation #temp num %= #10 num
        /scoreboard players operation #temp2 num %= #10 num
        execute(unless score "#temp2" num matches 0 unless score "#temp" num = "#temp2" num){ return 0; }

        /scoreboard players operation #trigger_type num /= #10 num
        /scoreboard players operation #criteria_type num /= #10 num
        execute(unless score "#criteria_type" num matches 0 unless score "#trigger_type" num = "#criteria_type" num){ return 0; }

        return 1;
    }
    var _criteria = [];
    def check_criteria(var criteria){
        print("\ncheck_criteria\n", criteria);
        append(_criteria, criteria)
        # card_criteria.json 같은 구조로 조건 노드 만들어서 재귀적으로 검사
        set_score("#criteria_type", "num", criteria.type);
        # or : 1
        # and : 2
        # event : 3
        # command : 4
        execute(if score "#criteria_type" num matches 3){
            var triggers = get_data("storage", "40planet:dus", "ingame.trigger_queue");
            set_score("#event_type", "num", criteria.value);

            while(triggers[0]){
                var trigger = triggers[0];
                del(triggers[0]);
                print("trigger type :", trigger.type, "| criteria type :", criteria.value);
                if(check_trigger(trigger.type, criteria.value)){
                    print("trigger matched!\n");
                    del(_criteria[-1]);
                    return 1;
                }
            }

            del(_criteria[-1]);
            return 0;
        }
        execute(if score "#criteria_type" num matches 2){
            while(_criteria[-1].value[0]){
                if(check_criteria(_criteria[-1].value[0])){
                    del(_criteria[-1].value[0]);
                }
                else {
                    del(_criteria[-1]);
                    return 0;
                }
            }
            del(_criteria[-1]);
            return 1;
        }
        execute(if score "#criteria_type" num matches 1){
            while(_criteria[-1].value[0]){
                if(check_criteria(_criteria[-1].value[0])){
                    del(_criteria[-1]);
                    return 1;
                }
                del(_criteria[-1].value[0]);
            }
            del(_criteria[-1]);
            return 0;
        }
        execute(if score "#criteria_type" num matches 4){
            var command = _criteria[-1].value;
            /scoreboard players set #temp num 0
            /$execute store result score #temp num run $(command)

            del(_criteria[-1]);
            return get_score("#temp", "num");
        }
        del(_criteria[-1]);
    }
#



##############
## 스택 조작 ##
##############

    # 체인 스택 비어있는지 확인하는 함수
    def is_empty(){
        execute(unless data storage 40planet:dus effect_chain[0]){ return 1; }
        return 0;
    }

    # 체인 스택에 효과를 추가하는 함수(링크)
    def add(var uuid, var functions, var card, var type, var delay){
        # card 파라미터에서 functions, type, delay 받아오는걸로 바꾸기
        set_data("storage", "40planet:dus", 'effect_chain_element', {
            owner: uuid,
            functions: functions,
            item: card,
            effect_type: type,
            delay: delay

        });
        /data modify storage 40planet:dus ingame.effect_chain prepend from storage 40planet:dus effect_chain_element

        # TODO : ~의 효과 발동! 텍스트에서 텍스처 띄우는 기능으로 호버이벤트에 카드 이미지 넣기
        /tellraw @a[tag=card_player] "대충 테스트의 효과 발동 시도"

        # 체인 스택에 이벤트 추가했다는 플래그 보내기. 이후 플래그처리 단계에서 처리

        /scoreboard players set #add_event flag 1
    }

    def top(){
        return get_data("storage", "40planet:dus", "ingame.effect_chain[0]");
    }

    def pop(){
        var effect_ele = top();
        /data remove storage 40planet:dus ingame.effect_chain[0]
        return effect_ele;
    }
#




##############
## 스택 처리 ##
##############
    # 이 부분은 어떠한 연출도 없음. 그냥 쌓여있는 효과들을 처리하는 부분. 연출은 각 효과를 추가할 때 처리하도록

    # uuid 매크로로 함수 실행
    def uuid_execute(var uuid, var fun){
        /$execute as $(uuid) run $(fun)
    }

    # 카드의 처리가 끝났다는 신호 보내기
    def end_card_effect(){
        /scoreboard players set #is_end_card_effect flag 1
        # 스캐줄 거는건 flag 처리 단계에서 감지해서 다음 행동 하도록 해야 할 듯
        /execute if function __namespace__:is_empty run schedule function __namespace__:execute_top 1t
    }

    # 스택 원소 처리 시작
    def execute_top(){
        /scoreboard players set #is_end_card_effect flag 0
        effect_ele = pop();
        set_score("effect_type", "num", effect_ele.effect_type);
        var functions = effect_ele.functions;
        var owner = effect_ele.owner;

        while(functions[0]){
            uuid_execute(owner, functions[0]);
            del(functions[0]);
        }

        # TODO : ~의 효과 발동! 텍스트에서 텍스처 띄우는 기능으로 호버이벤트에 카드 이미지 넣기
        /tellraw @a[tag=card_player] "대충 테스트의 효과 발동!\n\n"

        if(effect_ele.delay){
            var delay = effect_ele.delay;
            /$schedule function __namespace__:end_card_effect $(delay)t
        } else {
            end_card_effect();
        }
    }
#
